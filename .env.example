# Add as many aliases as needed. Prefix each account's settings with its uppercase alias.
# Aliases: letters, digits and underscores, starting with a letter; case-insensitive.
# Omit MAIL_ACCOUNTS for legacy gmail/work configuration; set empty to disable all accounts.
MAIL_ACCOUNTS=personal,studio,archive

# First Gmail account: use a Google app password, NOT your regular password.
PERSONAL_IMAP_HOST=imap.gmail.com
PERSONAL_IMAP_PORT=993
PERSONAL_USER=
PERSONAL_APP_PASSWORD=
PERSONAL_DRAFTS_FOLDER=

# Second Gmail account (independent credentials).
STUDIO_IMAP_HOST=imap.gmail.com
STUDIO_IMAP_PORT=993
STUDIO_USER=
STUDIO_APP_PASSWORD=
STUDIO_DRAFTS_FOLDER=

# Any other TLS IMAP provider.
ARCHIVE_IMAP_HOST=imap.example.org
ARCHIVE_IMAP_PORT=993
ARCHIVE_USER=
ARCHIVE_PASSWORD=
ARCHIVE_DRAFTS_FOLDER=
